{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eklavya - GDL Chennai CFS",
  "version": "1.0.0",
  "identifier": "com.gateway.yms.yardtwin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eklavya - GDL Chennai CFS",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "url": "index.html",
        "userAgent": "YMSYardTwin/1.0 (Desktop)"
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Eklavya - GDL Chennai CFS"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© Eklavya | Gateway Distriparks — Chennai CFS",
    "shortDescription": "Enterprise 3D Digital Twin for Container Yard Operations",
    "longDescription": "Adaptive 3D yard navigation, container search, and live equipment tracking — desktop edition.",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": true,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "http://127.0.0.1:5000/downloads/update-manifest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
